<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SubAI Game Translator"
        android:textColor="@color/accent_cyan"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Terjemahkan Subtitle Game Cerita (The Walking Dead, RPG, dll.) Langsung di Layar Secara Melayang"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

    <!-- Language Selector Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLanguage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="14dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan Bahasa Game"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bahasa Game:"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinnerSourceLang"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terjemahkan Ke:"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/spinnerTargetLang"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Action Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="14dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardLanguage">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="1. Izinkan Layar Mengambang (Wajib)"
                android:textColor="@color/black"
                app:backgroundTint="@color/accent_cyan" />

            <Button
                android:id="@+id/btnStartService"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="2. Aktifkan Bola Melayang (Mulai Game)"
                android:textColor="@color/white"
                app:backgroundTint="@color/purple_500" />

            <Button
                android:id="@+id/btnStopService"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Matikan Tombol Melayang"
                android:textColor="@color/white"
                android:visibility="gone"
                app:backgroundTint="#D32F2F" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Status: Klik tombol 1 untuk memberikan izin tampilan."
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Guide Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGuide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="14dp"
        app:strokeColor="#2A2A2A"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardActions">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 Cara Pakai Saat Main Game:"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="1. Klik 'Aktifkan Bola Melayang' lalu buka game Anda (The Walking Dead, dll.).\n2. Ikon bola melayang 'AI' akan standby di pinggir layar game.\n3. Saat teks dialog/subtitle game muncul, KETUK BOLA TERSEBUT.\n4. Terjemahan bahasa Indonesia langsung melayang di atas layar game tanpa perlu keluar game!"
                android:textColor="#CCCCCC"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
