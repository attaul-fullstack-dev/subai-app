<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Floating Ball Icon -->
    <FrameLayout
        android:id="@+id/cardBubble"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tvBubbleText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="AI"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Quick Action Menu (Expandable on Tap) -->
    <LinearLayout
        android:id="@+id/layoutQuickMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#D9000000"
        android:padding="4dp"
        android:layout_marginStart="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMenuArea"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📐 Area"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <Button
            android:id="@+id/btnMenuToggleAuto"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="▶️ Auto: ON"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="8dp" />

        <Button
            android:id="@+id/btnMenuClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:backgroundTint="#D32F2F"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
